# Beta Sites deployments use the public production dataset corpus read-only instead of cloning D1
# and R2. Leave unset in production. This must be an HTTPS origin without credentials or a path.
BETA_DATA_ORIGIN=https://minecraftrecipetree.craftsmannsoftware.com

# Temporary server-only feature gate for core uploads and dataset-channel administration. Keep it
# false except during one authorized publication session, then remove it after channel activation.
DATASET_ADMIN_ENABLED=false

# Server-only operator credential for core uploads and dataset-channel administration. Use
# 32-8192 UTF-8 bytes without whitespace/control characters, then remove it after the session.
CORE_DATASET_UPLOAD_TOKEN=replace-with-a-random-32-to-8192-byte-secret

# Temporary server-only preview ingestion gate. Set all three values for one immutable sidecar,
# then remove them after commit. Serving identity comes from the D1 dataset catalog, not an env var.
PREVIEW_UPLOAD_ENABLED=false
PREVIEW_UPLOAD_ASSET_SET_ID=replace-with-the-new-sidecar-asset-set-id
PREVIEW_UPLOAD_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Persistent server-only credential for the feedback inbox. Keep this separate from upload tokens.
FEEDBACK_ADMIN_TOKEN=replace-with-a-random-feedback-admin-token-at-least-32-characters

# Persistent server-only fine-grained GitHub token with Issues: write and Contents: write
# permissions for only Filostorm/MinecraftRecipeTree. Used to store errors.json on the isolated
# export-failure-reports branch and file one deduplicated issue per pack or mod version.
GITHUB_ISSUES_TOKEN=replace-with-a-fine-grained-github-token-at-least-32-characters

# Local uploaders receive the matching token through these variables or a mode-0600 --token-file.
# Never expose either credential through an EXPO_PUBLIC_* variable.
